    "name": "Rust",
    "author": "support@pterodactyl.io",
    "description": "在 Rust 裡，唯一的目標就是生存下去。為此你必須克服飢餓、口渴與寒冷等種種困境：生火、搭建庇護所、獵殺動物取得肉品；提防其他玩家，必要時獵殺他們取得肉品；也可以與其他玩家結盟組成聚落。不擇手段，只求活下去。",
    "features": [
        "steam_disk_space"
    ],
    "docker_images": {
        "ghcr.io\/pterodactyl\/games:rust": "ghcr.io\/pterodactyl\/games:rust"
    },
    "file_denylist": [],
    "startup": ".\/RustDedicated -batchmode +server.port {{SERVER_PORT}} +server.queryport {{QUERY_PORT}} +server.identity \"rust\" +rcon.port {{RCON_PORT}} +rcon.web true +server.hostname \\\"{{HOSTNAME}}\\\" +server.level \\\"{{LEVEL}}\\\" +server.description \\\"{{DESCRIPTION}}\\\" +server.url \\\"{{SERVER_URL}}\\\" +server.headerimage \\\"{{SERVER_IMG}}\\\" +server.logoimage \\\"{{SERVER_LOGO}}\\\" +server.maxplayers {{MAX_PLAYERS}} +rcon.password \\\"{{RCON_PASS}}\\\" +server.saveinterval {{SAVEINTERVAL}} +app.port {{APP_PORT}}  $( [ -z ${MAP_URL} ] && printf %s \"+server.worldsize \\\"{{WORLD_SIZE}}\\\" +server.seed \\\"{{WORLD_SEED}}\\\"\" || printf %s \"+server.levelurl {{MAP_URL}}\" ) {{ADDITIONAL_ARGS}}",
    "config": {
        "files": "{}",
        "startup": "{\r\n    \"done\": \"Server startup complete\"\r\n}",
        "logs": "{}",
        "stop": "quit"
    },
    "scripts": {
        "installation": {
            "script": "#!\/bin\/bash\r\n# steamcmd 基礎安裝腳本\r\n#\r\n# 伺服器檔案位置：\/mnt\/server\r\n\r\nSRCDS_APPID=258550\r\n\r\n## 以防有人移除了預設值。\r\nif [ \"${STEAM_USER}\" == \"\" ]; then\r\n    echo -e \"尚未設定 steam 使用者。\\n\"\r\n    echo -e \"正在使用匿名使用者。\\n\"\r\n    STEAM_USER=anonymous\r\n    STEAM_PASS=\"\"\r\n    STEAM_AUTH=\"\"\r\nelse\r\n    echo -e \"使用者已設定為 ${STEAM_USER}\"\r\nfi\r\n\r\n## 下載並安裝 steamcmd\r\ncd \/tmp\r\nmkdir -p \/mnt\/server\/steamcmd\r\ncurl -sSL -o steamcmd.tar.gz https:\/\/steamcdn-a.akamaihd.net\/client\/installer\/steamcmd_linux.tar.gz\r\ntar -xzvf steamcmd.tar.gz -C \/mnt\/server\/steamcmd\r\nmkdir -p \/mnt\/server\/steamapps # 若此資料夾不存在，修正 steamcmd 磁碟寫入錯誤\r\ncd \/mnt\/server\/steamcmd\r\n\r\n# 若不這麼做，即使以 root 執行 SteamCMD 也會因故失敗。\r\n# 反正這在安裝流程結束時也會被變更。\r\nchown -R root:root \/mnt\r\nexport HOME=\/mnt\/server\r\n\r\n## 使用 steamcmd 安裝遊戲\r\n.\/steamcmd.sh +force_install_dir \/mnt\/server +login ${STEAM_USER} ${STEAM_PASS} ${STEAM_AUTH} +app_update ${SRCDS_APPID} ${EXTRA_FLAGS} validate +quit ## 視安裝情況可能需要其他旗標（說的就是你，cs 1.6）\r\n\r\n## 設定 32 位元函式庫\r\nmkdir -p \/mnt\/server\/.steam\/sdk32\r\ncp -v linux32\/steamclient.so ..\/.steam\/sdk32\/steamclient.so\r\n\r\n## 設定 64 位元函式庫\r\nmkdir -p \/mnt\/server\/.steam\/sdk64\r\ncp -v linux64\/steamclient.so ..\/.steam\/sdk64\/steamclient.so",
            "container": "ghcr.io\/pterodactyl\/installers:debian",
            "entrypoint": "bash"
        }
    },
